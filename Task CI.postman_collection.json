    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const task = pm.response.json();",
              "",
              "// Read the email of the authenticated test user",
              "const expectedOwner = pm.environment.get(\"email\");",
              "",
              "// Verify that the task was successfully created",
              "pm.test(\"Task creation should return 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Verify that the response contains a numeric task ID",
              "pm.test(\"Task ID should exist\", function () {",
              "    pm.expect(task.id).to.be.a(\"number\");",
              "});",
              "",
              "// Verify that the task title matches the request body",
              "pm.test(\"Task title should be correct\", function () {",
              "    pm.expect(task.title).to.eql(",
              "        \"Postman Automated Task\"",
              "    );",
              "});",
              "",
              "// Verify that the task belongs to the authenticated user",
              "pm.test(\"Task owner should be correct\", function () {",
              "    pm.expect(task.owner).to.eql(expectedOwner);",
              "});",
              "",
              "// Verify that the default task status is false",
              "pm.test(\"Task completion status should be false\", function () {",
              "    pm.expect(task.done).to.eql(false);",
              "});",
              "",
              "// Save the created task ID for later requests",
              "if (task.id) {",
              "    pm.environment.set(\"task_id\", task.id);",
              "",
              "    console.log(\"Created task ID:\", task.id);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
