    {
      "name": "Get All Tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const tasks = pm.response.json();",
              "",
              "// Read values created during previous requests",
              "const expectedOwner = pm.environment.get(\"email\");",
              "const createdTaskId = Number(",
              "    pm.environment.get(\"task_id\")",
              ");",
              "",
              "// Print response information for debugging",
              "console.log(\"HTTP status:\", pm.response.code);",
              "console.log(\"Number of tasks:\", tasks.length);",
              "console.log(\"All tasks:\", tasks);",
              "console.log(",
              "    \"Task IDs:\",",
              "    tasks.map(function (task) {",
              "        return task.id;",
              "    })",
              ");",
              "",
              "// Verify that the endpoint returns HTTP 200",
              "pm.test(\"Task list should return 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verify that the response is an array",
              "pm.test(\"Response should be an array\", function () {",
              "    pm.expect(tasks).to.be.an(\"array\");",
              "});",
              "",
              "// Verify that the task list is not empty",
              "pm.test(\"Task list should not be empty\", function () {",
              "    pm.expect(tasks.length).to.be.above(0);",
              "});",
              "",
              "// Verify that every task belongs to the authenticated user",
              "pm.test(\"All tasks should belong to the authenticated user\", function () {",
              "    const allTasksBelongToUser = tasks.every(",
              "        function (task) {",
              "            return task.owner === expectedOwner;",
              "        }",
              "    );",
              "",
              "    pm.expect(allTasksBelongToUser).to.eql(true);",
              "});",
              "",
              "// Verify that the task created earlier exists in the list",
              "pm.test(\"Created task should exist in the task list\", function () {",
              "    const createdTaskExists = tasks.some(",
              "        function (task) {",
              "            return task.id === createdTaskId;",
              "        }",
              "    );",
              "",
              "    pm.expect(createdTaskExists).to.eql(true);",
              "});",
              "",
              "// Verify that every task contains the required fields",
              "pm.test(\"Every task should contain the required fields\", function () {",
              "    tasks.forEach(function (task) {",
              "        pm.expect(task).to.have.property(\"id\");",
              "        pm.expect(task).to.have.property(\"owner\");",
              "        pm.expect(task).to.have.property(\"title\");",
              "        pm.expect(task).to.have.property(\"done\");",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
