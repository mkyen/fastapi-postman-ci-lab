    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const body = pm.response.json();",
              "",
              "// Verify that login was successful",
              "pm.test(\"Login should return 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verify that the response contains an access token",
              "pm.test(\"Access token should exist\", function () {",
              "    pm.expect(body.access_token).to.be.a(\"string\");",
              "    pm.expect(body.access_token).not.to.be.empty;",
              "});",
              "",
              "// Save the token for protected requests",
              "if (pm.response.code === 200 && body.access_token) {",
              "    pm.environment.set(",
              "        \"access_token\",",
              "        body.access_token",
              "    );",
              "",
              "    console.log(\"Access token saved successfully\");",
              "} else {",
              "    // Remove any token left from a previous failed run",
              "    pm.environment.unset(\"access_token\");",
              "",
              "    console.log(\"Access token was not saved because login failed\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
