    {
      "name": "register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const body = pm.response.json();",
              "",
              "// Verify that the user was successfully created",
              "pm.test(\"Register should return 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Verify that the response contains a numeric user ID",
              "pm.test(\"User ID should exist\", function () {",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "});",
              "",
              "// Verify that the registered email matches the generated email",
              "pm.test(\"Registered email should match the test email\", function () {",
              "    pm.expect(body.email).to.eql(",
              "        pm.environment.get(\"email\")",
              "    );",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate a unique value for each collection run",
              "const uniqueId = `${Date.now()}_${Math.floor(Math.random() * 10000)}`;",
              "",
              "// Create a unique email address for the new test user",
              "const generatedEmail = `ci_user_${uniqueId}@lab.com`;",
              "",
              "// Store the generated credentials in the active environment",
              "pm.environment.set(\"email\", generatedEmail);",
              "pm.environment.set(\"password\", \"CorrectPassword123!\");",
              "",
              "// Remove values left from a previous collection run",
              "pm.environment.unset(\"access_token\");",
              "pm.environment.unset(\"task_id\");",
              "",
              "// Print the generated email in the Postman Console",
              "console.log(\"Generated test email:\", generatedEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
