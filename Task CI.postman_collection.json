      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the JSON response body",
              "const user = pm.response.json();",
              "",
              "// Read the email generated during the registration request",
              "const expectedEmail = pm.environment.get(\"email\");",
              "",
              "// Print values for debugging",
              "console.log(\"Expected email:\", expectedEmail);",
              "console.log(\"Actual email:\", user.email);",
              "",
              "// Verify that the protected endpoint returns HTTP 200",
              "pm.test(\"Current user endpoint should return 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verify that the returned user matches the logged-in user",
              "pm.test(\"User email should match the logged-in user\", function () {",
              "    pm.expect(user.email).to.eql(expectedEmail);",
              "});",
              "",
              "// Verify that the response contains a numeric user ID",
              "pm.test(\"User ID should exist\", function () {",
              "    pm.expect(user.id).to.be.a(\"number\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
